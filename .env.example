# Puerto en el que corre el servidor Express
PORT=8080

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Cadena de conexion a MongoDB (Atlas o local)
MONGO_URL=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/tienda-api

# Secreto usado para firmar y verificar los JWT
JWT_SECRET=cambiar_este_valor_por_un_secreto_largo_y_aleatorio

# Tiempo de expiracion del JWT (formato aceptado por jsonwebtoken: "1d", "2h", etc)
JWT_EXPIRES_IN=1d

# Cantidad de salt rounds para bcrypt (opcional, con valor por defecto en el codigo)
BCRYPT_SALT_ROUNDS=10
